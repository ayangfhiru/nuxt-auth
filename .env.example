# ---------------------------------------------------------------------------
# AuthOra — contoh environment variable (SALIN ke .env lalu isi nilainya).
# File ini harus selalu sinkron dengan kode: lib/auth-config.ts + lib/env.ts.
# JANGAN pernah menaruh kredensial asli di file ini.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
NUXT_PUBLIC_APP_NAME=AuthOra
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth (WAJIB — server gagal start bila kosong)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (WAJIB)
DATABASE_URL=

# Email provider — saat ini hanya "smtp" (Nodemailer) yang diimplementasikan.
# Lihat docs/AUTH_FLOW.md bagian "Email provider setup".
EMAIL_PROVIDER=smtp
EMAIL_FROM="AuthOra <no-reply@example.com>"

# SMTP (WAJIB bila EMAIL_PROVIDER=smtp)
# Development lokal: jalankan Mailpit/Mailhog di port 2525, atau pakai kredensial
# SMTP asli (mis. Gmail App Password).
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# OTP (opsional — nilai di bawah adalah default yang dipakai bila tidak diisi)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRES_IN=300
AUTH_OTP_RESEND_COOLDOWN=60
AUTH_OTP_MAX_ATTEMPTS=5

# Password policy (opsional)
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128

# Session (opsional, dalam detik)
AUTH_SESSION_EXPIRES_IN=604800
AUTH_SESSION_UPDATE_AGE=86400
